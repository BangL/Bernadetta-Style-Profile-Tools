            <post hook_id="lib/managers/menu/raid_menu/controls/raidguicontrollistitemcharacterselectbutton" script_path="raidguicontrollistitemcharacterselectbutton.lua" />
            <!-- Button functionality -->
            <post hook_id="lib/managers/menu/raid_menu/characterselectiongui" script_path="characterselectiongui.lua" />
      </hooks>
</mod>