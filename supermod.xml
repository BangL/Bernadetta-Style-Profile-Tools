            <update identifier="bernadettas-profile-tools">
                <host meta="https://raw.githubusercontent.com/BangL/raid-mods-meta/main/bernadettas-profile-tools.json"/>
            </update>
      </updates>

      <hooks>
            <!-- Button creation -->
            <post hook_id="lib/managers/menu/raid_menu/controls/raidguicontrollistitemcharacterselect" script_path="raidguicontrollistitemcharacterselect.lua" />
